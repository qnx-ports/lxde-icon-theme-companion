# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=lxde-icon-theme
pkgver=0.5.2
pkgrel=0
pkgdesc="lxde icon theme"
url="https://github.com/lxde/lxde-icon-theme/"
arch="noarch"
options="!check"  # Icons only, no binaries.
license="LGPL-3.0-or-later" #TODO: make sure this is correct
makedepends="autoconf automake"
source="$pkgname-$pkgver.tar.gz::https://github.com/lxde/$pkgname/archive/refs/tags/$pkgver.tar.gz
        qnx-fix.patch"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
    default_prepare
    autoreconf -fiv
}

build() {
    ./configure --prefix=/usr
    make

}

package() {
    make DESTDIR="$pkgdir" install
}


